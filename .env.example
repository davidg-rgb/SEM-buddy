# Google Ads API -- Developer token (required for API access)
# Set via: sem config set developer_token YOUR_TOKEN
# Or set here and it will be read by python-dotenv
GOOGLE_ADS_DEVELOPER_TOKEN=

# SpyFu API (optional -- competitor intelligence)
SPYFU_API_KEY=

# ValueSERP API (optional -- SERP data)
VALUESERP_API_KEY=

# Anthropic (required -- ad copy generation)
ANTHROPIC_API_KEY=

# NOTE: Google Ads OAuth credentials (client_id, client_secret, refresh_token)
# are managed via 'sem auth login' and stored in the OS keyring.
# Place your client_secret.json in ~/.sem-master/credentials/
