# SpyFu API (optional -- competitor intelligence)
SPYFU_API_KEY=

# ValueSERP API (optional -- SERP data)
VALUESERP_API_KEY=

# Ad copy generation uses the local `claude` CLI (Claude Code OAuth session)
# via subprocess -- no Anthropic API key needed. If `claude` is not on PATH,
# generators fall back to deterministic Swedish templates.
# Set to "1" to force template-only behavior (e.g. for CI / dry-runs).
SEM_DISABLE_LLM=

# NOTE: Google Ads OAuth credentials (client_id, client_secret, refresh_token)
# are managed via 'sem auth login' and stored in the OS keyring.
# Place your client_secret.json in ~/.sem-master/credentials/
#
# Developer token: set via 'sem config set developer_token YOUR_TOKEN'
# MCC customer ID: set via 'sem config set mcc_customer_id 123-456-7890'
