{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ad Copy Patterns",
  "description": "Headline and description patterns for Swedish Google Ads RSA generation.",
  "type": "object",
  "required": ["headline_patterns", "description_patterns", "pinning_strategy"],
  "properties": {
    "headline_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern", "type", "max_chars"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "max_chars": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "description_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern", "type", "max_chars"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "max_chars": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "pinning_strategy": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": false
}
